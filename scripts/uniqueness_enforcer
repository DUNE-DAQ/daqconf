#!/bin/env python3

from daqconf.uniqueness_enforcer import UniquenessEnforcerContextManager
import click
from pathlib import Path

@click.command()
@click.option('--config_folder', '-c', type=click.Path(exists=True, file_okay=False, dir_okay=True, path_type=Path))
@click.option('--output-csv', '-o', type=click.Path(file_okay=True, dir_okay=False, path_type=Path), help='Output CSV file to log duplicates', default=None)
def enforce_uniqueness(config_folder: Path, output_csv: Path):
    """Enforce uniqueness constraints on the configuration files in CONFIG_FOLDER.
    Optionally log duplicates to OUTPUT_CSV.
    """
    with UniquenessEnforcerContextManager(config_folder, output_csv) as enforcer:
        enforcer()

if __name__ == "__main__":
    enforce_uniqueness()